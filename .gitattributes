# Normalise line endings to LF everywhere.
#
# Development is on Windows but the backend runs on Linux, and shell scripts,
# SQL migrations and Dockerfiles break or behave oddly with CRLF. Forcing LF in
# both the repository and the working tree keeps diffs clean and avoids the
# "every line changed" commits that follow a machine switch.
* text=auto eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.svga binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks      binary

# Generated — collapse in diffs and exclude from language statistics.
package-lock.json linguist-generated=true -diff
