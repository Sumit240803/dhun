# The API base URL the app talks to.
#
# EXPO_PUBLIC_ prefixed values are INLINED INTO THE BUNDLE at build time and are
# readable by anyone with the APK. Only ever put non-secret configuration here —
# never a key, never a token. Secrets belong on the server.
#
# localhost does NOT work from a physical device: the phone resolves it to
# itself. Use the development machine's LAN address, or an ngrok/Expo tunnel.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Set per build profile in eas.json for staging and production.
EXPO_PUBLIC_ENV=development
