    {
      "name": "Wallet",
      "description": "Balances, packs, purchases and the coins-to-gems conversion.\n\n**Every endpoint here that moves money requires `Idempotency-Key`** — the collection pre-request script generates one automatically.\n\nFor purchases the header is NOT what makes it safe: the ledger key is derived from the receipt, so replaying a captured receipt under a fresh key still credits exactly once. Send request 3 twice with the same `purchaseToken` to see `replayed: true`.",
      "item": [
        {
          "name": "1 - Balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/wallet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "wallet"
              ]
            },
            "description": "Coins, gems, user level, and lifetime purchased coins.\n\nLevel accrues on PURCHASE, not on spend — free coins are ordinary coins now, so scoring on spend would let daily check-ins be ground into levels."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Coin packs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/wallet/packs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "wallet",
                "packs"
              ]
            },
            "description": "The 55 coins/rupee table. Totals match the source doc so advertised value is preserved; only the coin/gem split is new.\n\nStarter is deliberately off-formula (105 coins/rupee) — its job is teaching the gifting loop, not margin."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
