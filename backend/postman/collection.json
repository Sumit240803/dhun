            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('db up', () => pm.expect(pm.response.json().db).to.eql('up'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route (404 envelope)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "does-not-exist"
              ]
            },
            "description": "Proves the error envelope is wired up before any real endpoint exists."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('code is NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Phone OTP with WhatsApp primary and SMS fallback, JWT access + rotating refresh, guest upgraded in place.\n\n**Run them in order.** Each request saves what the next one needs into the environment, so the whole signup flow works end to end without copying tokens by hand.\n\n`devCode` is returned by the OTP request outside production, which is what makes this runnable before TRAI DLT registration completes.",
      "item": [
        {
          "name": "1 · Create guest session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/guest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "guest"
              ]
            },
            "description": "Anonymous but real identity, called on first launch. The user can watch, follow and earn free coins before signing up — and keeps all of it, because signup fills in this same row rather than replacing it.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device\": {\n    \"deviceId\": \"{{deviceId}}\",\n    \"platform\": \"android\",\n    \"appVersion\": \"1.0.0\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.environment.set('accessToken', b.accessToken);",
                  "pm.environment.set('refreshToken', b.refreshToken);",
                  "if (b.user) pm.environment.set('userId', b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 · Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "otp",
                "request"
              ]
            },
            "description": "Rate limited to 5 per number per hour. Requesting a new code immediately invalidates the previous one.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"channel\": \"whatsapp\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "// Only present outside production — the console provider logs it there.",
                  "if (b.devCode) pm.environment.set('otpCode', b.devCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 · Verify OTP (upgrades the guest)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Sends the guest access token, so the guest is upgraded IN PLACE and keeps its user id. Without a token a brand new registered user is created instead.\n\nIf the number already belongs to an account, that account is signed into and the guest row is left alone — balances are never merged between two identities.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{otpCode}}\",\n  \"device\": {\n    \"deviceId\": \"{{deviceId}}\",\n    \"platform\": \"android\",\n    \"appVersion\": \"1.0.0\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.environment.set('accessToken', b.accessToken);",
                  "pm.environment.set('refreshToken', b.refreshToken);",
                  "if (b.user) pm.environment.set('userId', b.user.id);",
                  "pm.test('is now active', () => pm.expect(pm.response.json().user.status).to.eql('active'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4 · Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "me"
              ]
            },
            "description": "Current user with their active scoped role grants."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "5 · Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "profile"
              ]
            },
            "description": "Sets the profile. **A date of birth is required before any money endpoint will work** — hard rule #5 is enforced where money moves, not just as an optional field, so it cannot be bypassed by skipping the question.\n\nAn under-18 date returns 403 UNDERAGE. Without one, purchases return 403 DOB_REQUIRED so the app knows to open the date picker.\n\nAge is evaluated against the calendar date in IST, so someone turning 18 today passes from 00:00 IST. A date that matches the YYYY-MM-DD shape but is not a real date (`2000-02-31`), or one in the future, returns 422 INVALID_DOB — not UNDERAGE, because a typo must not send a user into an age-appeal flow.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Rahul\",\n  \"dateOfBirth\": \"1998-04-12\",\n  \"gender\": \"male\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "6 · Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates: the presented token is retired and a new pair issued.\n\nPresenting an already-rotated token means two parties hold it, so the entire device chain is revoked and the response is 401 REFRESH_TOKEN_REUSED. Try running this twice in a row to see it.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.environment.set('accessToken', b.accessToken);",
                  "pm.environment.set('refreshToken', b.refreshToken);",
                  "if (b.user) pm.environment.set('userId', b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "7 · Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes refresh tokens for this device, or every device with allDevices: true. The access token stays valid until it expires — that is the trade for stateless auth.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"allDevices\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalog",
      "description": "Server-driven config. Day-1 non-negotiable #6: adding a gift or changing a price must never need an app release, because old app versions stay alive forever.\n\nCached 30s in process; an admin edit clears it immediately.",
      "item": [
        {
          "name": "Gifts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/catalog/gifts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "catalog",
                "gifts"
              ]
            },
            "description": "20 gifts across 5 tiers, repriced for 55 coins/rupee.\n\n`payoutRateBp` is PER GIFT, never a global constant, so event gifts can carry a different rate later.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
