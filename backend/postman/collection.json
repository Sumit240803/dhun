          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/wallet/purchase/iap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "wallet",
                "purchase",
                "iap"
