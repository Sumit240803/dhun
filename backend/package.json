{
  "name": "backend",
  "version": "0.1.0",
  "description": "Modular monolith backend for the social app",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "migrate:status": "tsx --env-file=.env scripts/migrate.ts --status",
    "db:reset": "tsx --env-file=.env scripts/migrate.ts --reset",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d postgres postgres-test redis",
    "docker:down": "docker compose down",
    "worker": "tsx --env-file=.env src/workers/index.ts",
    "worker:run": "tsx --env-file=.env src/workers/index.ts --run",
    "gateway": "tsx watch --env-file=.env src/gateway/index.ts",
    "seed:testers": "tsx --env-file=.env scripts/seed-testers.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jose": "^6.2.9",
    "kysely": "^0.27.4",
    "livekit-server-sdk": "^2.19.0",
    "pg": "^8.12.0",
    "uuidv7": "^1.0.2",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.21",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
