NODE_ENV=development
PORT=3000

# Local PostgreSQL 17 service (D:\postgres), two databases on one server.
# The test suite drops and rebuilds liveapp_test, so it never touches dev data.
DATABASE_URL=postgres://liveapp:liveapp@localhost:5432/liveapp
TEST_DATABASE_URL=postgres://liveapp:liveapp@localhost:5432/liveapp_test

# docker-compose.yml is kept as an alternative (Postgres on 5432, test on 5433,
# Redis on 6379). Not required — the local service is the default path.
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-secret-change-in-every-real-environment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# console = log the OTP instead of sending it. Switch to msg91 once TRAI DLT
# registration and template approval are complete (Track 0 in docs/build-plan.md).
EMAIL_PROVIDER=console
EMAIL_CODE_TTL_MINUTES=30
EMAIL_CODES_PER_HOUR=5

OTP_PROVIDER=console
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PER_PHONE_PER_HOUR=5
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# stub = accept a well-formed token without calling the store (dev/test only).
IAP_PROVIDER=stub
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay-test-secret

# Real-time provider — vendor undecided (open decision #5: Agora / ZEGO / LiveKit)
RTC_APP_ID=
RTC_SERVER_SECRET=

# --- RTC (LiveKit) -----------------------------------------------------------
# Leave blank and the app still boots — every RTC endpoint answers 503 instead.
#
# LOCAL TESTING: run `livekit-server --dev --bind 0.0.0.0` and use the fixed
# development credentials below. `--dev` accepts only these.
#   LIVEKIT_URL=ws://192.168.1.2:7880      (the LAN address a phone can reach,
#                                           never localhost — the phone resolves
#                                           that to itself)
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
#
# PRODUCTION: generate your own with `openssl rand -hex 32` and put the same
# pair in the LiveKit server's config. They are not issued by anyone — the
# secret signs join tokens, so whoever holds it can speak as anyone.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=10
LIVEKIT_REQUEST_TIMEOUT_SECONDS=8
LIVEKIT_EMPTY_TIMEOUT_SECONDS=120
