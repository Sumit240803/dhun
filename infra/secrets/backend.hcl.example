# Remote state backend: a PRIVATE Cloudflare R2 bucket.
#
# Copy to infra/secrets/backend.hcl (git-ignored). State holds the database
# passwords and the generated JWT secret, so the bucket must never be public
# and its API token should be scoped to this one bucket.
#
# R2 rather than DigitalOcean Spaces: the account already exists, there is no
# $5/month Spaces minimum, and R2 supports the conditional writes that
# `use_lockfile` needs, so two people (or two pipeline runs) can never apply
# at once.
#
# The backend credentials are NOT in this file. Export them before init:
#   export AWS_ACCESS_KEY_ID=<R2 token access key id>
#   export AWS_SECRET_ACCESS_KEY=<R2 token secret>

bucket = "dhun-terraform-state"
region = "auto"

endpoints = {
  s3 = "https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
}

use_lockfile                = true
use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
