# Copy to infra/secrets/staging.tfvars (and prod.tfvars). Those files are
# git-ignored; this example is the only one committed. Never paste a real value
# into this file.

do_token = "dop_v1_…"  # DigitalOcean → API → Generate New Token, read + write

# Keys already added at DigitalOcean → Settings → Security → SSH Keys.
ssh_key_names = ["sumit-laptop"]

# The pipeline's deploy key: ssh-keygen -t ed25519 -C dhun-deploy -f dhun-deploy -N ""
# Public half here; private half → GitHub environment secret DEPLOY_SSH_KEY.
deploy_public_key = "ssh-ed25519 AAAA… dhun-deploy"

alert_emails      = ["ops@dhunlive.in"]
slack_webhook_url = "" # optional, Slack-compatible incoming webhook

# Provider credentials for the app. Single-line values only; minify JSON.
# Anything Terraform computes itself (DATABASE_URL, REDIS_URL, JWT_SECRET,
# NODE_ENV, TRUST_PROXY) is set by the stack and cannot be overridden here.
app_secrets = {
  LIVEKIT_URL          = "wss://….livekit.cloud"
  LIVEKIT_API_KEY      = "…"
  LIVEKIT_API_SECRET   = "…"

  R2_ACCOUNT_ID        = "…"
  R2_ACCESS_KEY_ID     = "…"
  R2_SECRET_ACCESS_KEY = "…"
  R2_PUBLIC_URL        = "https://media-staging.dhun.live"

  # Alert transports (build-plan M21 slice 3). Any one is enough.
  ALERT_TELEGRAM_BOT_TOKEN = ""
  ALERT_TELEGRAM_CHAT_ID   = ""
  ALERT_WEBHOOK_URL        = ""

  # Prod only, once Track 0 clears:
  # MSG91_AUTH_KEY = "…"  MSG91_SENDER_ID = "…"  MSG91_TEMPLATE_ID = "…"
  # RAZORPAY_KEY_ID = "…"  RAZORPAY_KEY_SECRET = "…"
  # GOOGLE_PLAY_PACKAGE_NAME = "com.dhunlive.dhun"
  # GOOGLE_PLAY_SERVICE_ACCOUNT_JSON = "{…minified…}"
  # EXPO_ACCESS_TOKEN = "…"
}
